{
  "manifest_version": 3,
  "name": "nes_recycle Form Filler",
  "short_name": "nes_recycle",
  "version": "0.1.0",
  "description": "Fill the Nespresso recycling pickup form from locally saved profile values.",
  "homepage_url": "https://github.com/rioriost/nes_recycle",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://input-form.jp/modules/nespresso_recyclingathome/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://input-form.jp/modules/nespresso_recyclingathome/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "nes_recycle",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
